{
  "rules_version": "1.0",
  "description": "Browser Forensics Rule-Based Categorization Dataset",
  "categories": [
    {
      "category": "Cybercrime",
      "severity": "high",
      "weight": 10,
      "artifact_types": [
        "search_terms",
        "history",
        "downloads",
        "bookmarks"
      ],
      "keywords": [
        "sql injection",
        "xss",
        "csrf",
        "payload",
        "reverse shell",
        "metasploit",
        "exploit-db",
        "keylogger",
        "rat malware",
        "burp suite",
        "wireshark",
        "nmap",
        "shellcode",
        "password cracking",
        "hydra",
        "privilege escalation",
        "malware",
        "botnet",
        "ransomware",
        "exploit"
      ],
      "domains": [
        "exploit-db.com",
        "0day.today",
        "hackforums.net",
        "cracked.to",
        "nulled.to",
        "github.com"
      ],
      "regex": [
        "\\b(?:sql\\s*injection|xss|csrf)\\b",
        "\\b(?:metasploit|hydra|nmap|wireshark)\\b",
        "\\b(?:payload|shellcode|reverse\\s*shell)\\b"
      ]
    },

